# Von Python automatisch erzeugte Dateien.
# Sie entstehen beim Ausführen neu und gehören nicht ins Repository.
__pycache__/
*.pyc

# Persönliche Tastenbelegung. Wird beim ersten Ändern eines Hotkeys
# angelegt; fehlt sie, startet das Programm mit der Standardbelegung.
timer_config.json

# Persönliche gespeicherte Timerstände. Entsteht beim ersten Speichern.
timer_staende.json

# Testdatei der Stände-Tests. Wird normalerweise sofort wieder gelöscht.
test_staende_tmp.json
